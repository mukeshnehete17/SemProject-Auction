# Local development (SQLite) — default, unchanged workflow.
DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="generated-via-openssl-rand-base64-32"

# Resend Email Integration (optional — if unset, logs to console gracefully)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="TORI Marketplace <auctions@tori.auction>"

# --- Supabase PostgreSQL (placeholders only — never real secrets) ---
# Runtime (app server, Vercel): Transaction-mode pooler, port 6543.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations + one-time transfer script: direct Session-mode URL, port 5432.
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require"
# Optional pool tuning (defaults shown).
# PG_POOL_MAX="5"
# Production seeding stays refused unless this exact override is set.
# ALLOW_PROD_SEED="i-understand-data-loss"
